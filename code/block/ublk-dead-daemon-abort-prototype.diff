+/*
+ * Batch IO doesn't bind io to a task, so the char device is bound to the
+ * thread group which opened it: nobody else is allowed to issue io commands
+ * or to copy io data, see ublk_ch_batch_io_uring_cmd() and ublk_user_copy().
+ */
+static bool ublk_is_batch_owner(const struct ublk_device *ub)
+{
+	return task_tgid(current) == READ_ONCE(ub->srv_pid);
+}
+
+/* Has the thread group which opened the char device exited? */
+static bool ublk_srv_exited(struct ublk_device *ub)
+{
+	struct task_struct *t;
+	struct pid *pid;
+	bool exited;
+
+	spin_lock(&ub->lock);
+	pid = get_pid(ub->srv_pid);
+	spin_unlock(&ub->lock);
+
+	if (!pid)
+		return false;
+
+	rcu_read_lock();
+	t = pid_task(pid, PIDTYPE_PID);
+	exited = !t || (READ_ONCE(t->exit_state) && !delay_group_leader(t));
+	rcu_read_unlock();
+	put_pid(pid);
+	return exited;
+}
+
+/*
+ * ublk_ch_release() fails requests owned by a dead ublk server, but it only
+ * runs after the last reference to /dev/ublkcN is dropped, and that reference
+ * may be held by someone other than the server: a forked helper, a SCM_RIGHTS
+ * receiver, a vfork child.
+ *
+ * Nobody can complete this io any more if:
+ *
+ * - io->task is exiting, since COMMIT is only accepted from io->task, or
+ * - the owner thread group has exited in case of batch IO
+ *
+ * Fail it on behalf of the dead server in the same way as COMMIT does:
+ * references held off-daemon (user copy, registered buffer) are still covered
+ * by io->ref.
+ *
+ * ->canceling has to be set first, since this io no longer has a uring_cmd
+ * for dispatching the next request with the same tag.
+ */
+static bool ublk_io_orphaned(struct ublk_device *ub, const struct ublk_io *io)
+{
+	struct task_struct *t;
+
+	if (ublk_dev_support_batch_io(ub))
+		return ublk_srv_exited(ub);
+
+	t = READ_ONCE(io->task);
+	return t && (READ_ONCE(t->flags) & PF_EXITING);
+}
+
+static bool ublk_abort_dead_io(struct ublk_device *ub, struct ublk_io *io)
+{
+	bool batch = ublk_dev_support_batch_io(ub);
+	struct request *req = NULL;
+	bool compl = true;
+
+	if (!ublk_io_orphaned(ub, io))
+		return false;
+
+	ublk_start_cancel(ub);
+
+	mutex_lock(&ub->cancel_mutex);
+	if (batch)
+		ublk_io_lock(io);
+	if (io->flags & UBLK_IO_FLAG_OWNED_BY_SRV) {
+		req = io->req;
+		io->flags &= ~UBLK_IO_FLAG_OWNED_BY_SRV;
+		io->res = -EIO;
+		if (ublk_dev_need_req_ref(ub))
+			compl = ublk_sub_req_ref(io);
+	}
+	if (batch)
+		ublk_io_unlock(io);
+	if (req && compl)
+		__ublk_complete_rq(req, io, ublk_dev_need_map_io(ub), NULL);
+	mutex_unlock(&ub->cancel_mutex);
+	return req != NULL;
+}
+
+static void ublk_abort_dead_ios(struct ublk_device *ub)
+{
+	u16 i, j;
+
+	for (i = 0; i < ub->dev_info.nr_hw_queues; i++) {
+		struct ublk_queue *ubq = ublk_get_queue(ub, i);
+
+		for (j = 0; j < ubq->q_depth; j++)
+			ublk_abort_dead_io(ub, &ubq->ios[j]);
+
+		/* requests queued in the fifo, but never fetched */
+		if (ublk_support_batch_io(ubq) && ublk_srv_exited(ub)) {
+			ublk_start_cancel(ub);
+			mutex_lock(&ub->cancel_mutex);
+			ublk_abort_batch_queue(ub, ubq);
+			mutex_unlock(&ub->cancel_mutex);
+		}
+	}
+}
