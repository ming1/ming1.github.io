--- a/src/common/options/global.yaml.in
+++ b/src/common/options/global.yaml.in
@@ -5262,6 +5262,22 @@ options:
   see_also:
   - bluestore_cache_meta_ratio
   with_legacy: true
+- name: bluestore_onode_cache_probation_ratio
+  type: float
+  level: advanced
+  desc: Share of each onode cache shard that holds onodes not yet used again.
+    An onode enters this probation segment on its first use and moves to the
+    main LRU only after it is used in two cache age bins later than the one it
+    came in (see bluestore_cache_age_bin_interval). One pass over many objects
+    (scrub, backfill, writes that are not read back) then recycles the
+    probation segment instead of filling the whole cache. 0 disables it,
+    admitting every onode at once.
+  default: 0.1
+  min: 0
+  max: 1
+  see_also:
+  - bluestore_cache_meta_evict_limit
+  - bluestore_cache_age_bin_interval
 - name: bluestore_cache_autotune
   type: bool
   level: dev
