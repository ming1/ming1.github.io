From e0f1c1640575790cd6e7330bd38b615a4ecad7d4 Mon Sep 17 00:00:00 2001
From: Ming Lei <ming.lei@clyso.com>
Date: Fri, 30 Oct 2026 08:39:10 -0500
Subject: [PATCH] osd: read EC recovery data with FADVISE_DONTNEED

Both erasure-code backends read the shards for a reconstruction with no
fadvise flag: the legacy backend passes 0 and the new backend's recovery
read_request_t never sets its flags. That data is sent once and not read
again on the source, yet BlueStore keeps it in its buffer cache. On a
six-OSD test cluster with a 4+2 pool, each of the five source OSDs of a
shard rebuild grew a 1.9 GiB data cache this way.

Pass FADVISE_DONTNEED on both paths. BlueStore then serves the read
without inserting it into the cache; buffers already cached are untouched.

PR #73273 does the same for the replicated backend's push reads through
RecoveryHandle::cache_dont_need; this change does not depend on it. That
change excepts an object a client op is waiting for. There is no exception
here: an EC client read needs k shards from k OSDs, so warming the sources
for one object buys little, and one read of the sources decodes every
missing shard, so the replicated 'pushed to more than one shard' case has
no EC analogue.

Signed-off-by: Ming Lei <ming.lei@clyso.com>
---
 src/osd/ECBackendL.cc | 4 +++-
 src/osd/ECCommon.cc   | 4 +++-
 src/osd/ECCommon.h    | 4 +++-
 3 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/src/osd/ECBackendL.cc b/src/osd/ECBackendL.cc
index 7d98cad28f5..fe21cd8b460 100644
--- a/src/osd/ECBackendL.cc
+++ b/src/osd/ECBackendL.cc
@@ -200,7 +200,9 @@ struct RecoveryMessages {
     bool attrs)
   {
     list<ec_align_t> to_read;
-    to_read.emplace_back(ec_align_t{off, len, 0});
+    // shard data is sent once; keep it out of the sources' buffer cache
+    to_read.emplace_back(
+      ec_align_t{off, len, CEPH_OSD_OP_FLAG_FADVISE_DONTNEED});
     ceph_assert(!recovery_reads.count(hoid));
     want_to_read.insert(make_pair(hoid, std::move(_want_to_read)));
     recovery_reads.insert(
diff --git a/src/osd/ECCommon.cc b/src/osd/ECCommon.cc
index 3068e233a9b..8a493a5add2 100644
--- a/src/osd/ECCommon.cc
+++ b/src/osd/ECCommon.cc
@@ -1613,7 +1613,9 @@ void ECCommon::RecoveryBackend::continue_recovery_op(
         want_omap_keys,
         op.recovery_progress.omap_recovered_to,
         available,
-        chunk_size
+        chunk_size,
+        // shard data is sent once; keep it out of the sources' buffer cache
+        CEPH_OSD_OP_FLAG_FADVISE_DONTNEED
       );
 
       int r = read_pipeline.get_min_avail_to_read_shards(
diff --git a/src/osd/ECCommon.h b/src/osd/ECCommon.h
index ead96890b1f..e674294d8d8 100644
--- a/src/osd/ECCommon.h
+++ b/src/osd/ECCommon.h
@@ -150,7 +150,9 @@ struct ECCommon {
 
     read_request_t(const ECUtil::shard_extent_set_t &shard_want_to_read,
                    WantAttrs want_attrs, WantOmapHeader want_omap_header, WantOmapKeys want_omap_keys,
-                   std::string omap_read_from, uint64_t omap_max_bytes, uint64_t object_size) :
+                   std::string omap_read_from, uint64_t omap_max_bytes,
+                   uint64_t object_size, uint32_t flags = 0) :
+      flags(flags),
       shard_want_to_read(shard_want_to_read),
       zeros_for_decode(shard_want_to_read.get_max_shards()),
       shard_reads(shard_want_to_read.get_max_shards()),
