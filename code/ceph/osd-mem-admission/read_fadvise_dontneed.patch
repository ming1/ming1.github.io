 doc/man/8/ceph.rst             |  4 ++--
 doc/rados/operations/pools.rst | 17 +++++++++++++++++
 qa/standalone/mon/misc.sh      |  2 +-
 qa/workunits/cephtool/test.sh  |  2 +-
 src/mon/MonCommands.h          |  6 ++++--
 src/mon/OSDMonitor.cc          |  6 +++++-
 src/osd/PrimaryLogPG.cc        | 14 ++++++++++++++
 src/osd/osd_types.h            |  6 ++++++
