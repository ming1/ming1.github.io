#!/usr/bin/env bpftrace
/*
 * wstats.bt -- BlueStore write-path statistics over a period.
 *
 * Usage:  bpftrace wstats.bt <path-to-ceph-osd>
 *         e.g.  bpftrace wstats.bt /root/git/ceph/ceph/build/bin/ceph-osd
 *         ... run workload ... Ctrl-C (stop+report)
 *         The binary path is the positional parameter $1 in every probe;
 *         omitting it fails at parse time with "uprobe should have a target".
 *         Wildcard probes take ~10 s to attach against the big binary --
 *         wait for the "tracing..." banner before starting the workload.
 *
 * Pure event/byte statistics, no latency measurement (see wlat.bt for that).
 * Map-name prefixes a_..h_ order the report top-down along the write path:
 *   a_ transactions entering BlueStore
 *   b_ object writes and bytes
 *   c_ RocksDB key set/rmkey/merge per prefix (O=onode, P=pgmeta-omap,
 *      L=deferred, ...)
 *   d_ RocksDB commits; batch-size histogram = txcs amortized per
 *      sync commit (the two fdatasync barriers are paid per batch)
 *   e_ block-device writes keyed by issuing thread:
 *        tp_osd_tp      = object data (direct write path)
 *        bstore_kv_sync = RocksDB WAL via BlueFS
 *        finisher/other = deferred data replay
 *   f_ device flushes (fdatasync)   g_ BlueFS fsyncs   h_ deferred batches
 *
 * Probes are uprobes on the unstripped dev binary, using anchored wildcard
 * patterns like  _ZN9BlueStore*_txc_finishE*  instead of full mangled names:
 * the "_ZN<len><Class>" prefix pins the class and the trailing "E*" pins the
 * end of the method name.  The glob cannot pin the end of the SYMBOL:
 * optimized builds emit clones like foo.cold / foo.part.N whose entry does
 * not hold the function's parameters, silently corrupting counts.  Before
 * trusting a pattern on a new binary, verify it matches EXACTLY the intended
 * symbols:  bpftrace -l 'uprobe:BIN:PATTERN'
 * bufferlist length lives at offset 24 (gdb: ptype /o
 * ceph::buffer::v15_2_0::list -> _len).
 */

BEGIN { printf("tracing bluestore write path... Ctrl-C to stop\n"); }

/* ---- OSD -> BlueStore ------------------------------------------------ */

/* BlueStore::queue_transactions(CollectionHandle&, vector<Transaction>&, ...) */
uprobe:$1:_ZN9BlueStore*queue_transactionsE*
{ @a_txc_submitted = count(); }

/* BlueStore::_do_write(txc, coll, onode, offset, length, bl, flags) */
uprobe:$1:_ZN9BlueStore*_do_writeE*
{ @b_object_writes = count(); @b_object_write_bytes = sum(arg5); }

/* ---- RocksDB staging: which keys get written ------------------------- */

/* RocksDBStore::RocksDBTransactionImpl::set(prefix, key: string, bl) */
uprobe:$1:_ZN12RocksDBStore*3setE*S8_RK*
{ @c_kv_set[str(*(uint64*)arg1)] = count();
  @c_kv_set_bytes[str(*(uint64*)arg1)] = sum(*(uint32*)(arg3+24)); }

/* RocksDBStore::RocksDBTransactionImpl::set(prefix, key: char*+len, bl) */
uprobe:$1:_ZN12RocksDBStore*3setE*PKcmRK*
{ @c_kv_set[str(*(uint64*)arg1)] = count();
  @c_kv_set_bytes[str(*(uint64*)arg1)] = sum(*(uint32*)(arg4+24)); }

/* RocksDBStore::RocksDBTransactionImpl::rmkey (both overloads; prefix=arg1) */
uprobe:$1:_ZN12RocksDBStore*5rmkeyE*
{ @c_kv_rmkey[str(*(uint64*)arg1)] = count(); }

/* RocksDBStore::RocksDBTransactionImpl::merge(prefix, key, bl) */
uprobe:$1:_ZN12RocksDBStore*5mergeE*
{ @c_kv_merge[str(*(uint64*)arg1)] = count(); }

/* ---- RocksDB commit -------------------------------------------------- */

/* RocksDBStore::submit_transaction (async, deferred-cleanup etc.) */
uprobe:$1:_ZN12RocksDBStore*submit_transactionE*
{ @d_kv_commit_async = count(); }

/* BlueStore::_txc_apply_kv -- one call per txc entering the kv batch */
uprobe:$1:_ZN9BlueStore*_txc_apply_kvE*
{ @batchn++; }

/* RocksDBStore::submit_transaction_sync (the kv_sync_thread commit);
 * txcs applied since the last sync commit = this batch's size */
uprobe:$1:_ZN12RocksDBStore*submit_transaction_syncE*
{ @d_kv_commit_sync = count();
  if (@batchn > 0) { @d_kv_batch_txcs = hist(@batchn); }
  @batchn = 0; }

/* ---- block device ---------------------------------------------------- */

/* KernelDevice::aio_write(off, bl, ioc, buffered, hint); keyed by the
 * issuing thread, which identifies the writer (data vs WAL vs deferred) */
uprobe:$1:_ZN12KernelDevice*aio_writeE*
{ @e_disk_writes[comm] = count(); @e_disk_write_bytes[comm] = sum(*(uint32*)(arg2+24)); }

/* KernelDevice::flush() == fdatasync barrier */
uprobe:$1:_ZN12KernelDevice*flushE*
{ @f_disk_flushes = count(); }

/* ---- BlueFS (RocksDB's filesystem) ----------------------------------- */

/* BlueFS::fsync(FileWriter*) -- WAL file durability */
uprobe:$1:_ZN6BlueFS5fsyncE*
{ @g_bluefs_fsyncs = count(); }

/* ---- deferred replay ------------------------------------------------- */

/* BlueStore::_deferred_submit_unlock(OpSequencer*) -- background data write */
uprobe:$1:_ZN9BlueStore*_deferred_submit_unlockE*
{ @h_deferred_batches = count(); }

END { clear(@batchn); }
